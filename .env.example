# PostgreSQL Database Connection (Option 1: Single Connection String)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/locora

# PostgreSQL Database Connection (Option 2: Individual Parameters)
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=yourpassword
# SQL_DB_NAME=locora

# Locora AI Environment Variables
GEMINI_API_KEY=

# Stripe Payment Integration (Supports Sandbox Test Keys & Live Keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email Service Provider Integration (Choose Resend, SendGrid, or custom SMTP)
# Option 1: Resend API (Recommended)
RESEND_API_KEY=

# Option 2: SMTP Mail Server (Gmail, SendGrid SMTP, Mailgun, Outlook, cPanel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Locora AI <no-reply@locoraai.com>

# Option 3: SendGrid Web API
SENDGRID_API_KEY=

# Google & LinkedIn OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

